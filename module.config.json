{
  "name": "ordemServico",
  "slug": "ordemServico",
  "displayName": "Ordem de Serviços",
  "version": "1.0.1",
  "description": "Módulo personalizado com funcionalidades integradas",
  "author": "Equipe CORE",
  "category": "custom",
  "enabled": true,
  "dependencies": [
    {
      "type": "core",
      "name": "core",
      "version": ">=1.0.0"
    }
  ],
  "config": {
    "defaultSettings": {
      "showNotifications": true,
      "enableWidgets": true,
      "maxItems": 50,
      "enablePublicPages": true
    },
    "permissions": [
      "ordemServico.view",
      "ordemServico.create",
      "ordemServico.edit",
      "ordemServico.delete",
      "ordemServico.admin"
    ],
    "routes": [
      {
        "path": "/ordemServico",
        "component": "ordemServicoDashboardPage",
        "title": "Dashboard Ordem de Serviços",
        "protected": true,
        "permissions": [
          "ordemServico.view"
        ]
      },
      {
        "path": "/ordemServico/lista",
        "component": "ordemServicoListaPage",
        "title": "Lista",
        "protected": true,
        "permissions": [
          "ordemServico.view"
        ]
      },
      {
        "path": "/ordemServico/configuracoes",
        "component": "ordemServicoConfiguracoesPage",
        "title": "Configurações",
        "protected": true,
        "permissions": [
          "ordemServico.view"
        ]
      }
    ],
    "menuItems": [
      {
        "id": "ordemServico-main",
        "label": "Ordem de Serviços",
        "icon": "Wrench",
        "path": "/ordemServico",
        "order": 10,
        "permissions": [
          "ordemServico.view"
        ]
      }
