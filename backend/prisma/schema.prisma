generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model mod_ordem_servico_configs {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  key       String    @db.VarChar(255)
  value     String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("mod_ordem_servico_configs")
}

model mod_ordem_servico_clients {
  id                  String                     @id @default(uuid()) @db.Uuid
  tenantId            String                     @map("tenant_id")
  name                String                     @db.VarChar(255)
  document            String?                    @db.VarChar(20)
  phonePrimary        String                     @map("phone_primary") @db.VarChar(20)
  phoneSecondary      String?                    @map("phone_secondary") @db.VarChar(20)
  email               String?                    @db.VarChar(255)
  address             String?
  addressZip          String?                    @map("address_zip") @db.VarChar(10)
  addressStreet       String?                    @map("address_street") @db.VarChar(255)
  addressNumber       String?                    @map("address_number") @db.VarChar(20)
  addressComplement   String?                    @map("address_complement") @db.VarChar(100)
  addressNeighborhood String?                    @map("address_neighborhood") @db.VarChar(100)
  addressCity         String?                    @map("address_city") @db.VarChar(100)
  addressState        String?                    @map("address_state") @db.VarChar(2)
  observations        String?
  imageUrl            String?                    @map("image_url")
  isActive            Boolean?                   @default(true) @map("is_active")
  createdAt           DateTime?                  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?                  @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt           DateTime?                  @map("deleted_at") @db.Timestamp(6)
  ordens              mod_ordem_servico_ordens[]

  @@index([tenantId])
  @@index([isActive])
  @@unique([tenantId, id])
  @@map("mod_clientes")
}

model mod_ordem_servico_products {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id")
  code         String    @db.VarChar(50)
  name         String    @db.VarChar(255)
  type         String    @default("PRODUCT") @db.VarChar(20)
  price        Decimal   @default(0.00) @db.Decimal(10, 2)
  costPrice    Decimal?  @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  description  String?
  imageUrl     String?   @map("image_url")
  isActive     Boolean?  @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("mod_ordem_servico_products")
}

model mod_ordem_servico_ordens {
  id                       String                                @id @default(uuid()) @db.Uuid
  tenantId                 String                                @map("tenant_id")
  numero                   String
  clienteId                String                                @map("cliente_id") @db.Uuid
  usuarioResponsavelId     String                                @map("usuario_responsavel_id")
  tipoServico              String                                @map("tipo_servico")
  descricao                String
  observacoesInternas      String?                               @map("observacoes_internas")
  observacoesCliente       String?                               @map("observacoes_cliente")
  valorServico             Decimal?                              @default(0.00) @map("valor_servico") @db.Decimal(10, 2)
  formaPagamento           String?                               @map("forma_pagamento")
  status                   Int                                   @default(0)
  prioridade               String?                               @default("MEDIA")
  dataAbertura             DateTime?                             @default(now()) @map("data_abertura") @db.Timestamp(6)
  dataPrevisao             DateTime?                             @map("data_previsao") @db.Timestamp(6)
  dataConclusao            DateTime?                             @map("data_conclusao") @db.Timestamp(6)
  origemSolicitacao        String                                @map("origem_solicitacao")
  orcamentoAprovado        Boolean?                              @default(false) @map("orcamento_aprovado")
  motivoCancelamento       String?                               @map("motivo_cancelamento")
  equipamentoTipo          String?                               @map("equipamento_tipo")
  equipamentoMarca         String?                               @map("equipamento_marca")
  equipamentoModelo        String?                               @map("equipamento_modelo")
  equipamentoSerie         String?                               @map("equipamento_serie")
  equipamentoAcessorios    String?                               @map("equipamento_acessorios")
  equipamentoEstado        String?                               @map("equipamento_estado")
  equipamentoFotos         String?                               @map("equipamento_fotos")
  laudoTecnico             String?                               @map("laudo_tecnico")
  itens                    String?
  formatacaoSo             String?                               @map("formatacao_so")
  formatacaoBackup         Boolean?                              @default(false) @map("formatacao_backup")
  formatacaoBackupDescricao String?                              @map("formatacao_backup_descricao")
  formatacaoSenha          String?                               @map("formatacao_senha")
  garantiaDias             Int?                                  @default(0) @map("garantia_dias")
  valorConservacao         Decimal?                              @default(0) @map("valor_conservacao") @db.Decimal(10, 2)
  diasAtraso               Int?                                  @default(0) @map("dias_atraso")
  justificativaConservacao String?                               @map("justificativa_conservacao")
  dataLimiteRetirada       DateTime?                             @map("data_limite_retirada") @db.Timestamp(6)
  dataRetirada             DateTime?                             @map("data_retirada") @db.Timestamp(6)
  createdAt                DateTime?                             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?                             @default(now()) @map("updated_at") @db.Timestamp(6)
  cliente                  mod_ordem_servico_clients             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  historico                mod_ordem_servico_historico[]
  pagamentos               mod_ordem_servico_pagamentos[]
  alertasAbandono          mod_ordem_servico_alertas_abandono[]
  statusHistorico          mod_ordem_servico_status_historico[]
  notificacoes             mod_ordem_servico_order_notifications[]

  @@index([tenantId])
  @@index([status])
  @@index([numero])
  @@unique([tenantId, id])
  @@unique([tenantId, numero])
  @@map("mod_ordem_servico_ordens")
}

model mod_ordem_servico_historico {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id")
  ordemServicoId String                    @map("ordem_servico_id") @db.Uuid
  usuarioId      String                    @map("usuario_id")
  acao           String
  valorAnterior  String?                   @map("valor_anterior")
  valorNovo      String?                   @map("valor_novo")
  observacoes    String?
  createdAt      DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  ordem          mod_ordem_servico_ordens  @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ordemServicoId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_historico")
}

model mod_ordem_servico_notification_schedules {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id")
  title          String    @db.VarChar(255)
  content        String?
  audience       String?   @default("all") @db.VarChar(50)
  cronExpression String    @map("cron_expression") @db.VarChar(100)
  enabled        Boolean?  @default(true)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_notification_schedules")
}

model mod_ordem_servico_order_notifications {
  id           String                    @id @default(uuid()) @db.Uuid
  tenantId     String                    @map("tenant_id")
  ordemId      String                    @map("ordem_id") @db.Uuid
  type         String
  scheduledFor DateTime?                 @default(now()) @map("scheduled_for") @db.Timestamp(6)
  status       String                    @default("pending")
  errorMessage String?                   @map("error_message")
  metadata     Json?
  createdAt    DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?                 @default(now()) @map("updated_at") @db.Timestamp(6)
  ordem        mod_ordem_servico_ordens  @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_order_notifications")
}

model mod_ordem_servico_user_roles {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id")
  userId       String    @map("user_id")
  isTechnician Boolean?  @default(false) @map("is_technician")
  isAttendant  Boolean?  @default(true) @map("is_attendant")
  isAdmin      Boolean?  @default(false) @map("is_admin")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("mod_ordem_servico_user_roles")
}

model mod_ordem_servico_user_permissions {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  resource  String    @db.VarChar(50)
  action    String    @db.VarChar(50)
  allowed   Boolean?  @default(false)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy String    @map("created_by")

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, userId, resource, action])
  @@map("mod_ordem_servico_user_permissions")
}

model mod_ordem_servico_profile_permissions {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id")
  permissionId String    @map("permission_id")
  profile      String
  allowed      Boolean?  @default(true)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, permissionId, profile])
  @@map("mod_ordem_servico_profile_permissions")
}

model mod_ordem_servico_permission_audit {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  resource  String    @db.VarChar(50)
  action    String    @db.VarChar(50)
  oldValue  Boolean?  @map("old_value")
  newValue  Boolean   @map("new_value")
  changedBy String    @map("changed_by")
  changedAt DateTime? @default(now()) @map("changed_at") @db.Timestamp(6)
  reason    String?

  @@index([tenantId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_permission_audit")
}

model mod_ordem_servico_tipos_servico {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  nome      String    @db.VarChar(255)
  isDefault Boolean?  @default(false) @map("is_default")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, nome])
  @@map("mod_ordem_servico_tipos_servico")
}

model mod_ordem_servico_tipos_equipamento {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  nome      String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, nome])
  @@map("mod_ordem_servico_tipos_equipamento")
}

model mod_ordem_servico_templates {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id")
  name      String    @db.VarChar(255)
  content   String
  type      String?   @default("GENERAL") @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy String?   @map("created_by")

  @@index([tenantId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_templates")
}

model mod_ordem_servico_status_historico {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id")
  ordemServicoId String                    @map("ordem_servico_id") @db.Uuid
  statusAnterior Int                       @map("status_anterior")
  statusNovo     Int                       @map("status_novo")
  usuarioId      String                    @map("usuario_id")
  dataAlteracao  DateTime                  @default(now()) @map("data_alteracao") @db.Timestamp(6)
  observacoes    String?
  createdAt      DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  ordem          mod_ordem_servico_ordens  @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ordemServicoId])
  @@index([dataAlteracao(sort: Desc)])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_status_historico")
}

model mod_ordem_servico_pagamentos {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id")
  ordemServicoId String                    @map("ordem_servico_id") @db.Uuid
  formaPagamento String                    @map("forma_pagamento") @db.VarChar(50)
  valor          Decimal                   @db.Decimal(10, 2)
  parcelas       Int?                      @default(1)
  observacoes    String?
  createdAt      DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy      String                    @map("created_by")
  ordem          mod_ordem_servico_ordens  @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ordemServicoId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_pagamentos")
}

model mod_ordem_servico_alertas_abandono {
  id             String                              @id @default(uuid()) @db.Uuid
  tenantId       String                              @map("tenant_id")
  ordemServicoId String                              @map("ordem_servico_id") @db.Uuid
  numeroAlerta   Int                                 @map("numero_alerta")
  dataEnvio      DateTime                            @default(now()) @map("data_envio") @db.Timestamp(6)
  meioComunicacao String                             @map("meio_comunicacao") @db.VarChar(50)
  enviadoPor     String                              @map("enviado_por")
  mensagem       String?
  observacoes    String?
  createdAt      DateTime?                           @default(now()) @map("created_at") @db.Timestamp(6)
  ordem          mod_ordem_servico_ordens            @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  anexos         mod_ordem_servico_anexos_abandono[]

  @@index([tenantId])
  @@index([ordemServicoId])
  @@unique([tenantId, id])
  @@unique([ordemServicoId, numeroAlerta])
  @@map("mod_ordem_servico_alertas_abandono")
}

model mod_ordem_servico_anexos_abandono {
  id           String                            @id @default(uuid()) @db.Uuid
  tenantId     String                            @map("tenant_id")
  alertaId     String                            @map("alerta_id") @db.Uuid
  nomeArquivo  String                            @map("nome_arquivo") @db.VarChar(255)
  tipoArquivo  String                            @map("tipo_arquivo") @db.VarChar(100)
  tamanhoBytes Int?                              @map("tamanho_bytes")
  urlArquivo   String                            @map("url_arquivo")
  descricao    String?
  createdAt    DateTime?                         @default(now()) @map("created_at") @db.Timestamp(6)
  uploadedBy   String                            @map("uploaded_by")
  alerta       mod_ordem_servico_alertas_abandono @relation(fields: [alertaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([alertaId])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_anexos_abandono")
}

model mod_ordem_servico_notif_rules {
  id                String                           @id @default(uuid()) @db.Uuid
  tenantId          String                           @map("tenant_id")
  title             String
  description       String?
  enabled           Boolean?                         @default(true)
  triggerType       String                           @map("trigger_type")
  triggerConfig     Json                             @default("{}") @map("trigger_config")
  channel           String
  recipients        Json                             @default("[]")
  messageTemplate   String                           @map("message_template")
  maxExecutions     Int?                             @map("max_executions")
  currentExecutions Int?                             @default(0) @map("current_executions")
  lastExecutionAt   DateTime?                        @map("last_execution_at") @db.Timestamptz(6)
  nextExecutionAt   DateTime?                        @map("next_execution_at") @db.Timestamptz(6)
  expiresAt         DateTime?                        @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime?                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?                        @default(now()) @map("updated_at") @db.Timestamptz(6)
  history           mod_ordem_servico_notif_history[]
  states            mod_ordem_servico_notif_states[]

  @@index([tenantId])
  @@index([triggerType])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_notif_rules")
}

model mod_ordem_servico_notif_history {
  id             String                        @id @default(uuid()) @db.Uuid
  tenantId       String                        @map("tenant_id")
  ruleId         String                        @map("rule_id") @db.Uuid
  ordemServicoId String?                       @map("ordem_servico_id") @db.Uuid
  channel        String
  recipient      String
  content        String
  status         String
  errorMessage   String?                       @map("error_message")
  fingerprint    String?
  sentAt         DateTime?                     @default(now()) @map("sent_at") @db.Timestamptz(6)
  rule           mod_ordem_servico_notif_rules @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ruleId])
  @@index([ordemServicoId])
  @@index([fingerprint])
  @@unique([tenantId, id])
  @@map("mod_ordem_servico_notif_history")
}

model mod_ordem_servico_notif_states {
  tenantId       String                        @map("tenant_id")
  ruleId         String                        @map("rule_id") @db.Uuid
  ordemServicoId String                        @map("ordem_servico_id") @db.Uuid
  lastState      Json                          @map("last_state")
  lastNotifiedAt DateTime?                     @default(now()) @map("last_notified_at") @db.Timestamptz(6)
  createdAt      DateTime?                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  rule           mod_ordem_servico_notif_rules @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([tenantId, ruleId, ordemServicoId])
  @@map("mod_ordem_servico_notif_states")
}
